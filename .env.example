# Copy to .env and fill in. Never commit .env. The password is never stored here;
# it is requested at runtime with a hidden prompt.

SISENSE_BASE_URL=https://gahixreports.getinsured.com
SISENSE_EMAIL=

# Exact address-bar URL of "PY 2027 - OE Executive Dashboard", copied from the browser.
SISENSE_DASHBOARD_URL=https://gahixreports.getinsured.com/app/main/dashboards/6a98048ccef60720fe7f9b30
SISENSE_DASHBOARD_ID=6a98048ccef60720fe7f9b30
SISENSE_DASHBOARD_TITLE=PY 2027 - OE Executive Dashboard

# Login form selectors, verified with DevTools on the real login page.
# If no submit selector is set, Enter is pressed in the password field; if that
# does not submit the form the run stops and asks for a verified submit selector.
SISENSE_LOGIN_EMAIL_SELECTOR=#username
SISENSE_LOGIN_PASSWORD_SELECTOR=#password
SISENSE_LOGIN_SUBMIT_SELECTOR=

# Installed browser Playwright drives: msedge or chrome. No browser is ever
# downloaded; if this channel is not installed the run fails with
# CONFIGURED_BROWSER_NOT_AVAILABLE.
PLAYWRIGHT_BROWSER_CHANNEL=msedge

# Headed by default so SSO/MFA can be completed in the browser window.
SISENSE_HEADLESS=false

# Local debugging only: logs cookie names/domains/flags and HTTP header names
# (never values) to diagnose session problems.
SISENSE_DEBUG_SESSION=false

# Diagnostics only: log in, open the dashboard, passively inspect the
# dashboard's own JAQL requests (names/statuses only), then stop. This
# application sends no JAQL request in this mode.
SISENSE_DIAGNOSTICS_ONLY=false

# Phase 3B proof (validation only): also read the dashboard's own JAQL response
# for the verified widget and compare it with the application value. Sends no
# extra request; the passive value is never stored or reported.
SISENSE_PASSIVE_PROOF=false

# Wave 1 discovery (developer review only): summarize the dashboard's own JAQL
# widgets (structure only) into reports/discovery/. Sends no extra request;
# discovered metrics never enter history or the executive report.
SISENSE_DISCOVERY=false

# Wave 1 runtime validation (developer review only): read the values of the
# seven Wave 1 metrics from the dashboard's own responses into
# reports/validation/, with a per-widget definition fingerprint (hash only) as
# promotion evidence. Implies discovery. Sends no extra request; values here
# are never stored in history. (Production-verified passive metrics such as
# % Effectuated need no flag: they are read on every normal run.)
SISENSE_RUNTIME_VALIDATION=false

# Reporting (paths relative to the project folder). One snapshot per metric per
# UTC hour (or day); later runs in the same slot never overwrite it.
HISTORY_DB_PATH=data/history/oe_metrics.sqlite3
REPORTS_DIR=reports
SNAPSHOT_GRANULARITY=hour

# Timeout tiers (milliseconds)
SHORT_TIMEOUT=10000
DEFAULT_TIMEOUT=30000
SLOW_TIMEOUT=60000
VERY_SLOW_TIMEOUT=120000

# Retry (transient failures only: timeouts, connection resets, HTTP 502/503/504)
JAQL_MAX_ATTEMPTS=3
JAQL_BACKOFF_SECONDS=2,5,10
JAQL_BACKOFF_JITTER=0.2
